# UniqBotz Infrastructure — example environment (PLACEHOLDERS ONLY; never commit real values).
# Copy to .env.local for the dashboard, or export in the worker's shell. `.env*` files are git-ignored.

# ---- Dashboard (Next.js) -----------------------------------------------------------------
# "live" → the UI reads the control plane through /api/infra/* (read-only). Anything else → mock data.
NEXT_PUBLIC_INFRA_DATA_SOURCE=mock
# Server-side only (never NEXT_PUBLIC_*). The dashboard opens every read session read-only.
CONTROL_PLANE_DATABASE_URL=postgres://control_reader:REPLACE_ME@127.0.0.1:54329/control_plane
# Separate credential for authenticated, role-checked mutations (approvals, authorization, kill switch). Unset → every write refused.
CONTROL_PLANE_WRITER_DATABASE_URL=
# Authentication (Phase 3C). Unset/disabled → AUTHENTICATION NOT CONFIGURED (writes refused; anonymous reads refused once a
# production application is registered). Provider is an open decision (checklist S-1).
CONTROL_PLANE_AUTH_MODE=disabled
CONTROL_PLANE_AUTH_SECRET_REF=env:CONTROL_PLANE_TOKEN_SECRET
CONTROL_PLANE_AUTH_ISSUER=
CONTROL_PLANE_AUTH_AUDIENCE=
CONTROL_PLANE_AUTH_MAX_AGE_SECONDS=

# ---- Worker (manual CLI only; no scheduler in Phase 3B) ----------------------------------
# Deletion is DISABLED unless this is exactly "true". Leave it unset.
ALLOW_DELETION=false
# Environments the worker would ever delete from. "production" is rejected at start-up in Phase 3B.
DELETION_ALLOWED_ENVIRONMENTS=synthetic
DELETION_BATCH_SIZE=2000
# Archive storage (Phase 3C). Unset → ARCHIVE EXECUTION UNAVAILABLE. "local-directory" is a synthetic-only test destination.
# s3-compatible | gcs | supabase-storage are recognised but NOT implemented until the provider is decided (AR-1).
ARCHIVE_STORAGE_PROVIDER=
ARCHIVE_STORE_DIR=.archive-store
ARCHIVE_PURGE_ENABLED=false
# Comma-separated secret references that must be refused immediately (revocation).
SECRETS_REVOKED=
VERIFY_SCRATCH_DATABASE_URL=postgres://postgres:REPLACE_ME@127.0.0.1:54329/verify_scratch
# Application database passwords are referenced from the control plane as env:NAME, e.g.:
SYNTH_MONITOR_PASSWORD=REPLACE_ME
SYNTH_ARCHIVE_PASSWORD=REPLACE_ME
